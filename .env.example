# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e configure suas chaves

# Chave da API do OpenRouter (para múltiplos modelos de IA)
VITE_OPENROUTER_API_KEY=sua-chave-da-api-aqui

# Modelo padrão a ser usado (opcional - deixe vazio para usar o padrão do OpenRouter)
# VITE_DEFAULT_MODEL=gpt-4o-mini

# Outras configurações opcionais
# VITE_API_URL=https://api.exemplo.com
# VITE_APP_NAME=Meu Chatbot
